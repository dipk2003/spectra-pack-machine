# Public origin
# Keep each origin variable to one canonical URL; comma-separated local and
# production values can make auth callbacks and session-cookie names disagree.
SITE_ORIGIN=https://spectrapackmachines.com
NEXTAUTH_URL=https://spectrapackmachines.com
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
ADMIN_NAME=Dipanshu
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private developer dashboard (immutable Supabase Auth user UUID)
DEVELOPER_OWNER_USER_ID=
DEVELOPER_ADMIN_NAME=dipanshu

# Google measurement (prefer GTM; do not configure both GTM and direct GA tags)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_MEETING_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_EMAIL_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CATALOG_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CHAT_LABEL=

# Optional integrations
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=
